[run]
source = .
branch = False
omit =
    # ---- tests / fixtures / docs ------------------------------------------------
    tests/*
    */tests/*
    conftest.py
    test_*.py
    docs/*
    *.ipynb
    setup.py
    deoldify.py

    # ---- genuinely untestable offline (each file named; see the PR body for reasons) ----
    # Colab notebook export (shell magics, Colab-only widgets)
    us_stocks_colab.py
    # PostgreSQL-backed VCRUD indexer/handler: needs a live database server
    .vcrud_bin/db_handler.py
    .vcrud_bin/vcrud_manager.py
    # Live-network scanners / report generators: logic is dominated by yfinance, NSE/BSE/KRX/JPX,
    # SEC and RSS fetching plus Excel/print report layout; no seam to fake the providers without
    # rewriting the scripts
    us_stock_daily_report.py
    stock_daily_report_improved.py
    sg_stock_daily_report.py
    us_market_screener.py
    full_us_market_scan.py
    full_indian_market_scan.py
    full_japan_market_scan.py
    full_korea_market_scan.py
    full_european_market_scan.py
    nse_data_fetcher.py
    intraday_monitor.py
    sentiment_pipeline.py
    sentiment_price_link.py
    screener_analysis.py
    screener_in_auth.py
    phased_expansion_screener_11d.py
    deploy_expansion_screener.py
    global_20country_universe_screener.py
    stock_enricher.py
    portfolio_builder.py
    quarterly_data_collector.py
    quarterly_data_analyzer.py
    price_correlation_analysis.py
    price_criterion_correlation_tracker.py
    daily_combined_report.py
    # Long-running research jobs (multi-hour backtests / model sweeps / R bridge) over the live caches
    backtest_screeners.py
    backtest_weight_optimization.py
    backtest_weight_validation.py
    walk_forward_backtest.py
    pattern_discovery.py
    sector_analysis.py
    dl_strategy_eval.py
    ml_signal_engine.py
    f1_hyperparameter_tuning.py
    r_analysis.py
    # Home-directory / external-repo tooling (DuckDB + ~/repos, repo-wide git inventory, static text card)
    warehouse_etl_extras.py
    generate_repo_index.py
    inventory_all_data.py
    quick_reference.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
